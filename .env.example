# App
NEXT_PUBLIC_APP_NAME="IOE Page Automation Agent"
APP_BASE_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Kathmandu"
ADMIN_EMAIL="your-email@example.com"
AUTO_PUBLISH=false
MIN_CONFIDENCE_TO_AUTO_PUBLISH=0.92

# Database
# Use Supabase Postgres, Neon, Railway, or the local Docker Postgres from docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ioe_page_agent?schema=public"

# Redis is used by the background worker queue.
REDIS_URL="redis://localhost:6379"

# Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Facebook Page Publishing
# Create a Meta app, connect your Page, and use a Page access token with publish permissions.
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
FACEBOOK_GRAPH_VERSION="v26.0"

# Gmail inbox monitoring
# Create OAuth credentials in Google Cloud and paste the refresh token after first auth.
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
GMAIL_REFRESH_TOKEN=""
GMAIL_USER_ID="me"
GMAIL_QUERY="is:unread newer_than:14d (student OR exam OR result OR ioe OR notice OR problem)"

# Sources
IOE_EXAM_URL="https://exam.ioe.tu.edu.np/"
SOURCE_URLS="https://exam.ioe.tu.edu.np/"
NEWS_SEARCH_QUERY="Institute of Engineering IOE Nepal exam result notice"

# Optional: Google Programmable Search for wider IOE web monitoring.
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_ENGINE_ID=""

# Safety
BLOCKED_KEYWORDS="violence,hate,adult,political campaign,rumor,unverified death"
